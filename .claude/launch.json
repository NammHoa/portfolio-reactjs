{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "portfolio-client",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "client"
      ],
      "port": 5173
    },
    {
      "name": "portfolio-client-preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "preview",
        "--prefix",
        "client",
        "--",
        "--port",
        "5173",
        "--strictPort"
      ],
      "port": 5173
    },
    {
      "name": "portfolio-server",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "start",
        "--prefix",
        "server"
      ],
      "port": 5000
    }
  ]
}
