PORT=5000
MONGO_URI=mongodb://localhost:27017/portfolio
CLIENT_URL=http://localhost:5173

# How many proxies sit between the internet and this server. 1 on Render, 0 when running
# locally with no proxy. It decides which address the contact form rate limit counts.
TRUST_PROXY_HOPS=1

# Where contact-form notifications are sent (and, over Gmail, sent from).
# Resend (https://resend.com) sends over HTTPS. Set RESEND_API_KEY on hosts that block
# SMTP ports, such as Render's free tier. When it is set, Gmail below is not used for sending.
# Without a verified domain, Resend only delivers to the email of the account that owns the key.
RESEND_API_KEY=
# Optional sender, e.g. "Portfolio <contact@yourdomain.com>" once a domain is verified.
MAIL_FROM=

# Gmail App Password, not your normal Gmail password.
# Create one at https://myaccount.google.com/apppasswords
# (requires 2-Step Verification enabled on the account).
GMAIL_USER=your.email@gmail.com
GMAIL_APP_PASSWORD=
