PORT=5000
MONGO_URI=mongodb://localhost:27017/portfolio
CLIENT_URL=http://localhost:5173

# How many proxies sit between the internet and this server. 1 on Render, 0 when running
# locally with no proxy. It decides which address the contact form rate limit counts.
TRUST_PROXY_HOPS=1

# Gmail App Password, not your normal Gmail password.
# Create one at https://myaccount.google.com/apppasswords
# (requires 2-Step Verification enabled on the account).
GMAIL_USER=your.email@gmail.com
GMAIL_APP_PASSWORD=
